# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_STORAGE=./data/events.sqlite
# Confirmation mails. Without SMTP_URL the mail is only logged, nothing is sent.
# Any SMTP provider works, e.g. smtps://user:password@smtp.example.com:465
# SMTP_URL=
# MAIL_FROM=Campus Events <no-reply@your-domain.example>
# MAIL_MAX_ATTEMPTS=5
# MAIL_RETRY_INTERVAL_MS=30000
# MAIL_SEND_TIMEOUT_MS=10000

# Cache for the GET endpoints (in memory)
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=30

# Production only: serve the built frontend (web/dist) from the API. Default true when web/dist exists.
# SERVE_WEB=true

# RabbitMQ (assignment part 4). Local: docker compose up -d rabbitmq
# AMQP_URL=amqp://guest:guest@localhost:5672
